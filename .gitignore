# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Local verification builds
.build-*/

# Ignore the contents of the _redesign directory
_redesign/

# LaTeX build artefacts from scripts/build_cv.sh (the PDF itself is committed)
cv-latex/.build/
cv-latex/*.aux
cv-latex/*.bbl
cv-latex/*.bcf
cv-latex/*.blg
cv-latex/*.fdb_latexmk
cv-latex/*.fls
cv-latex/*.log
cv-latex/*.out
cv-latex/*.run.xml
cv-latex/*.synctex.gz
cv-latex/*.toc
